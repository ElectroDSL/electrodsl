circuit StarDeltaStarter {


supply AC_415V {

 phases 3
 frequency 50

}


motor PumpMotor {

 power 15kW
 phases 3

}


contactor Main {

 type contactor

}


contactor Star {

 type contactor

}


contactor Delta {

 type contactor

}


timer T1 {

 delay 10s

}


connection {

AC_415V -> Main
Main -> PumpMotor

Star -> PumpMotor
Delta -> PumpMotor

T1 -> Star
T1 -> Delta

}


}