EDSL 0.7
PROJECT "Motor Panel Quality Set" {
    CIRCUIT "Supply" {
        COMPONENT F1 : IEC-FUSE { rating = "10A" description = "Control protection" }
        COMPONENT X1 : IEC-RESISTOR { resistance = "1 kohm" tag = "Supply load" }
        CONDUCTOR W1 : F1.2 -> X1.1 { size = "1.5 mm2" phase = "L1" cable = "C1" length = "2 m" }
        CABLE C1 { cores = "3" size = "1.5 mm2" length = "2 m" }
        PORT CONTROL_POWER;
    }
}
