{
  "$schema": "https://json-schema.org/draft/2020-12/schema", "$id": "https://electrodsl.org/schemas/electrodsl-project-0.9.schema.json", "title": "ElectroDSL 0.9 Project", "type": "object",
  "required": ["schema", "name", "version", "language", "circuits"], "properties": { "schema": { "const": "electrodsl-project/0.9" }, "name": { "type": "string", "minLength": 1 }, "version": { "type": "string", "minLength": 1 }, "language": { "const": "0.9" }, "description": { "type": "string" }, "circuits": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "pattern": "\\.edsl$" } }, "library": { "type": "array", "items": { "type": "string" } }, "output": { "type": "object", "required": ["directory", "format"], "properties": { "directory": { "type": "string" }, "format": { "const": "svg" } } }, "reports": { "type": "boolean" } }, "additionalProperties": false
}
