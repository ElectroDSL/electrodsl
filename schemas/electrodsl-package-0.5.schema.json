{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://electrodsl.org/schema/package/0.5",
  "title": "ElectroDSL Package Manifest 0.5",
  "type": "object",
  "required": ["schema", "name", "version", "language", "license"],
  "properties": {
    "schema": { "const": "electrodsl-package/0.5" },
    "name": { "type": "string", "pattern": "^(?:@[a-z0-9-]+/)?[a-z0-9-]+$" },
    "version": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$" },
    "language": { "type": "string" },
    "description": { "type": "string" },
    "license": { "type": "string", "minLength": 1 },
    "components": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
    "modules": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
    "dependencies": { "type": "object", "additionalProperties": { "type": "string" } }
  },
  "additionalProperties": false
}
