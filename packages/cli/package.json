{
  "name": "@electrodsl/cli",
  "version": "1.0.0",
  "description": "ElectroDSL command line tools",
  "type": "module",
  "bin": {
    "edsl": "./dist/index.js"
  },
  "scripts": {
    "build": "tsup src/index.ts --format esm --dts"
  },
  "dependencies": {
    "@electrodsl/parser": "workspace:*",
    "@electrodsl/library": "workspace:*",
    "@electrodsl/renderer-svg": "workspace:*",
    "@electrodsl/validator": "workspace:*",
    "@electrodsl/ast": "workspace:*",
    "@electrodsl/integration": "workspace:*",
    "@electrodsl/formatter": "workspace:*",
    "@electrodsl/ir": "workspace:*",
    "@electrodsl/language-service": "workspace:*",
    "@electrodsl/language-server": "workspace:*",
    "@electrodsl/adapters": "workspace:*",
    "@electrodsl/ai-tools": "workspace:*",
    "@electrodsl/ci": "workspace:*",
    "@electrodsl/core": "workspace:*",
    "@electrodsl/project": "workspace:*",
    "@electrodsl/reports": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^26.1.1",
    "tsup": "^8.5.1",
    "typescript": "^5.7.3"
  }
}
